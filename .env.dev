# =============================================================
# Music Migration — LOCAL DEVELOPMENT environment
# =============================================================
# DO NOT use in production. Contains fake credentials only.
#
# DEV_MODE=true:
#   - every browser visit uses user_id=dev_user
#   - all services appear "connected" if DB has UserSession for dev_user
#   - to seed the DB: python -c "
#       import asyncio
#       from core.db.crud import save_yandex_token, save_soundcloud_token, save_spotify_token
#       asyncio.run(save_yandex_token('dev_user', 'fake'))
#       asyncio.run(save_soundcloud_token('dev_user', 'fake'))
#       asyncio.run(save_spotify_token('dev_user', 'fake'))
#     "
# =============================================================

DEV_MODE=true

# Show all logs (set explicitly — no magic)
LOG_LEVEL=DEBUG
LOG_FORMAT=pretty

# Database (matches docker-compose.dev.yml postgres service)
DATABASE_URL=postgresql+asyncpg://musicmigration:devpassword@postgres:5432/musicmigration
POSTGRES_PASSWORD=devpassword

# Redis (matches docker-compose.dev.yml redis service)
REDIS_URL=redis://redis:6379

# Session signing key (fake — dev only)
SECRET_KEY=dev-secret-key-change-in-production-32ch

# Internal API token (can be anything for dev)
API_INTERNAL_TOKEN=dev-internal-token

# Token encryption — leave empty for dev (plain text storage)
DB_ENCRYPTION_KEY=

# Admin UI
ADMIN_PASSWORD=admin

# Web UI
WEB_ENABLED=true
WEB_ALLOWED_IPS=

# Public URLs
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:8000

# OAuth — not needed (DB is pre-seeded with fake tokens via seed_dev.py)
# Fill in if you specifically want to test real OAuth flows locally
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REDIRECT_URI=http://localhost:8000/auth/soundcloud/callback

# Telegram bot — not started in dev compose
TELEGRAM_BOT_TOKEN=
ALLOWED_USERS=

# Migration settings
SC_PLAYLIST_BATCH_SIZE=500
MATCH_THRESHOLD=75.0
MATCH_UNCERTAIN_FLOOR=60.0
