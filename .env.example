# =============================================
# Music Migration — переменные окружения
# Скопируй в .env и заполни значения
# =============================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Whitelist Telegram user ID через запятую. Пусто = открыт для всех.
# Узнать свой ID: написать @userinfobot в Telegram
ALLOWED_USERS=

# --- Яндекс OAuth (oauth.yandex.ru) ---
# 1. Создать приложение → Веб-сервисы
# 2. Redirect URI: https://oauth.yandex.ru/verification_code
# 3. Права: login:info + Яндекс.Музыка (чтение)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Spotify OAuth (developer.spotify.com) ---
# 1. Create app → Redirect URI: https://yourdomain.com/auth/spotify/callback
# 2. Scopes: user-library-read, playlist-read-private, user-follow-read
# Оставь пустым чтобы скрыть Spotify из интерфейса
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://yourdomain.com/auth/spotify/callback

# --- SoundCloud OAuth (soundcloud.com/you/apps) ---
# 1. Зарегистрировать приложение → Redirect URI: https://yourdomain.com/auth/soundcloud/callback
# 2. Оставь пустым чтобы отключить SC OAuth (тогда в боте будет fallback на cookie)
SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REDIRECT_URI=https://yourdomain.com/auth/soundcloud/callback

# --- CLI режим (без бота, только для отладки) ---
YANDEX_TOKEN=
SOUNDCLOUD_TOKEN=

# --- База данных (только PostgreSQL) ---
# Локально:  postgresql+asyncpg://postgres:postgres@localhost:5432/musicmigration
# Docker:    postgresql+asyncpg://musicmigration:changeme@postgres:5432/musicmigration
DATABASE_URL=postgresql+asyncpg://musicmigration:changeme@postgres:5432/musicmigration
# Пароль postgres-контейнера (только для docker-compose)
POSTGRES_PASSWORD=changeme

# --- Redis ---
# Локально:  redis://localhost:6379
# Docker:    redis://redis:6379
REDIS_URL=redis://localhost:6379

# --- FastAPI ---
# Локально:  http://localhost:8000
# Docker:    http://api:8000
# Прод: https://yourdomain.com
API_BASE_URL=http://localhost:8000
# Токен для внутренних запросов бота к API (можно оставить пустым локально)
API_INTERNAL_TOKEN=

# --- Web UI / сессии ---
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Шифрование токенов в БД ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# --- Администратор ---
ADMIN_PASSWORD=admin

# --- Управление доступом к веб-интерфейсу ---
# false = отключить веб UI и админку (API и бот продолжают работать)
WEB_ENABLED=true
# Whitelist IP для веб-интерфейса через запятую. Пусто = разрешить всем.
# Пример: WEB_ALLOWED_IPS=1.2.3.4,5.6.7.8
WEB_ALLOWED_IPS=

# --- Прокси для Яндекс Музыки (RU IP) ---
# Нужен если сервер находится за пределами России
# Пример: socks5://user:pass@host:1080
YM_PROXY_URL=

# --- Настройки миграции ---
SC_PLAYLIST_BATCH_SIZE=500
MATCH_THRESHOLD=75.0
LOG_LEVEL=INFO
LOG_FORMAT=pretty           # pretty = colored stderr (dev), json = JSON stdout (Docker/Promtail)
