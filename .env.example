# =============================================
# Music Migration — environment variables
# Copy to .env and fill in real values
# =============================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Yandex OAuth (oauth.yandex.ru) ---
# 1. Create app -> Web services
# 2. Redirect URI: https://oauth.yandex.ru/verification_code
# 3. Permissions: login:info + Yandex.Music (read)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Comma-separated Telegram user IDs allowed to use the bot (empty = open to all)
ALLOWED_USERS=

# --- Encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# --- Database ---
# Docker: postgresql+asyncpg://musicmigration:changeme@postgres:5432/musicmigration
# Local:  sqlite+aiosqlite:///migration.db
DATABASE_URL=postgresql+asyncpg://musicmigration:changeme@postgres:5432/musicmigration

# Postgres password (used by docker-compose postgres service)
POSTGRES_PASSWORD=changeme

# --- Redis ---
# Docker: redis://redis:6379
# Local:  redis://localhost:6379
REDIS_URL=redis://redis:6379

# --- FastAPI ---
# Internal token for bot -> API calls
API_INTERNAL_TOKEN=

# URL the bot uses to reach the API (docker-compose internal: http://api:8000)
API_BASE_URL=http://api:8000

# Secret key for signing session cookies (generate a long random string)
SECRET_KEY=change-me-in-production

# --- Admin UI ---
ADMIN_PASSWORD=admin

# --- Migration tuning ---
SC_RATE_LIMIT_SLEEP=2.0
MATCH_THRESHOLD=75.0
LOG_LEVEL=INFO

# --- CLI tokens (local dev only) ---
YANDEX_TOKEN=
SOUNDCLOUD_TOKEN=
