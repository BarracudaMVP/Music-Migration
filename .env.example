# =============================================
# Music Migration — переменные окружения
# Скопируй в .env и заполни значения
# =============================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Whitelist ID пользователей через запятую. Пусто = открыт для всех.
# Узнать свой ID: написать @userinfobot в Telegram
ALLOWED_USERS=

# --- Яндекс OAuth (oauth.yandex.ru) ---
# 1. Создать приложение → Веб-сервисы
# 2. Redirect URI: https://oauth.yandex.ru/verification_code
# 3. Права: login:info + Яндекс.Музыка (чтение)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- CLI режим (без бота, только для отладки) ---
YANDEX_TOKEN=
SOUNDCLOUD_TOKEN=

# --- База данных ---
# Локально:  sqlite+aiosqlite:///migration.db
# Docker:    postgresql+asyncpg://musicmigration:changeme@postgres:5432/musicmigration
DATABASE_URL=sqlite+aiosqlite:///migration.db
# Только для docker-compose (пароль postgres-контейнера)
POSTGRES_PASSWORD=changeme

# --- Redis ---
# Локально:  redis://localhost:6379
# Docker:    redis://redis:6379
REDIS_URL=redis://localhost:6379

# --- FastAPI ---
# Локально:  http://localhost:8000
# Docker:    http://api:8000
API_BASE_URL=http://localhost:8000
# Токен для внутренних запросов бота к API (можно оставить пустым локально)
API_INTERNAL_TOKEN=

# --- Web UI / сессии ---
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Шифрование токенов в БД ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# --- Админка ---
ADMIN_PASSWORD=admin

# --- Настройки миграции ---
SC_RATE_LIMIT_SLEEP=2.0
MATCH_THRESHOLD=75.0
DB_PATH=migration.db
LOG_LEVEL=INFO
