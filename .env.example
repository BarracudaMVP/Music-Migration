# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=        # Токен от @BotFather

# Whitelist Telegram user ID (через запятую). Пусто = открыт для всех.
ALLOWED_USERS=

# --- Яндекс OAuth (oauth.yandex.ru) ---
# 1. Создать приложение → Веб-сервисы
# 2. Redirect URI: https://oauth.yandex.ru/verification_code
# 3. Права: login:info + Яндекс.Музыка (чтение)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- CLI режим (без бота) ---
YANDEX_TOKEN=
SOUNDCLOUD_TOKEN=

# --- Шифрование токенов в БД ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# --- Настройки миграции ---
SC_RATE_LIMIT_SLEEP=2.0    # Задержка между write-операциями SoundCloud (секунды)
MATCH_THRESHOLD=75.0       # Минимальный порог совпадения трека (0-100)
DB_PATH=migration.db
LOG_LEVEL=INFO
