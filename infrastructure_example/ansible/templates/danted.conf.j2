# Dante SOCKS5 — managed by Ansible (infra/ansible/ru.yml)
# Authentication: username/password required for all connections

logoutput: syslog

internal: 0.0.0.0 port = {{ dante_port }}
external: {{ ansible_default_ipv4.interface }}

socksmethod: username
clientmethod: none

user.privileged: root
user.unprivileged: nobody

client pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: error
}

socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    socksmethod: username
    log: error
}
